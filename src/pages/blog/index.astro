---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Search from "../../components/Search";
import type { SearchDoc } from "../../types";
import { SITE_NAME, SITE_URL } from "../../consts/seo";

const posts: CollectionEntry<"blog">[] = (await getCollection("blog"))
  .filter((post: CollectionEntry<"blog">) => !post.data.draft)
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

const searchDocs: SearchDoc[] = posts.map((post: CollectionEntry<"blog">) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  slug: post.id,
  pubDate: post.data.pubDate.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }),
}));

const title = `Blog | ${SITE_NAME}`;
const description = "Articles and notes by Wayne Mwashuma on engineering, learning, and shipping software.";
const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `${SITE_NAME} Blog`,
  url: `${SITE_URL}/blog/`,
  description,
  inLanguage: "en",
  blogPost: posts.map((post: CollectionEntry<"blog">) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    url: `${SITE_URL}/blog/${post.id}/`,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.modifiedDate ?? post.data.pubDate).toISOString(),
    description: post.data.description,
  })),
};
---

<BaseLayout title={title} description={description} type="website" schema={schema}>
  <main class="blog-page">
    <h2>Blog</h2>
    <p>Notes on building, learning, and shipping.</p>
    <Search posts={searchDocs} client:load></Search>
  </main>
</BaseLayout>
